[Unit]
Description=Wacom stylus tool switching: Button 2 toggles writer/eraser, Button 3 hover-tap cycles pencil/highlighter/laser (touch/movement pan untouched)
After=graphical-session.target

[Service]
ExecStart=/usr/bin/python3 /home/ubuntu/.local/bin/wacom-button3-toggle.py
Restart=on-failure
RestartSec=3
Environment=DISPLAY=:1
Environment=XAUTHORITY=/run/user/1000/gdm/Xauthority

[Install]
WantedBy=default.target
